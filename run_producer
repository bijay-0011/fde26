#!/bin/bash

SESSION="fde26_producer"

# 1. Create tmux session in detached mode if it doesn't exist
tmux has-session -t $SESSION 2>/dev/null

if [ $? != 0 ]; then
  tmux new-session -d -s $SESSION "source .myenv/bin/activate && uvicorn producer.app.main:app --reload --port 8000"
  tmux split-window -h -t $SESSION "source .myenv/bin/activate && sleep 2 && python -m producer.simulate.main"
  tmux select-pane -t 0
fi

# 2. Spawn a new native window in background (wt.exe = Windows Terminal, fallback = default WSL window)
cmd.exe /c start wt.exe wsl.exe -e tmux attach-session -t $SESSION 2>/dev/null || \
cmd.exe /c start wsl.exe -e tmux attach-session -t $SESSION 2>/dev/null

echo "🚀 Producer launched in a new native terminal window!"